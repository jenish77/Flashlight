{
  "expo": {
    "name": "Luma Torch",
    "slug": "luma-torch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lumatorch",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080C14",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lumatorch.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Luma Torch requires camera access to use the LED flashlight."
      }
    },
    "android": {
      "package": "com.lumatorch.app",
      "backgroundColor": "#080C14",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E17",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.FLASHLIGHT"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0E17",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 100
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Luma Torch to use the camera flash for the LED torch."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
